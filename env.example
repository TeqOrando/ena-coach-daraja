# NEVER put these values in the HTML.
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_PASSKEY=your_stk_push_passkey
DARAJA_SHORTCODE=247247

# Production: https://api.safaricom.co.ke
# Sandbox: https://sandbox.safaricom.co.ke
DARAJA_BASE_URL=https://api.safaricom.co.ke

# Must be a public HTTPS URL, e.g. https://payments.yourdomain.com
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example.com

PORT=3000
# Leave as * while testing. Restrict to your website domain in production.
CORS_ORIGIN=*
